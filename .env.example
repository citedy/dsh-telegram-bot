# dsh-telegram-bot configuration.
# Copy to the path your systemd unit points to (deploy/dsh-tg-bot.service
# uses /etc/dsh/dsh-tg-bot.env).

# Bot token from @BotFather
NTY_BOT_TOKEN=123456:ABC-DEF...

# Allowed chat ids (comma separated); NTY_BOT_CHAT_ID also works
TG_ADMIN_CHAT_IDS=123456789

# dsh sessions directory. Default: $DSH_HOME/sessions, usually ~/.dsh/sessions
#DSH_SESSIONS_DIR=

# Projects directory — git checkouts that hold a .env per project.
# Default: ~/.dsh/projects
#DSH_PROJECTS_DIR=

# getUpdates long-poll timeout (seconds). Default: 50
#DSH_TG_POLL_TIMEOUT_S=50
